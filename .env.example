# Copy to `.env` (or run `npm run setup`, which writes it for you).
FLARE_ACTIONS_URL=https://flare-actions.<your-subdomain>.workers.dev
RUNNER_TOKEN=paste-runner-token-here

# Optional: token for private-repo checkout on BYO runners. Not needed
# when the dashboard Connect GitHub flow is used with managed seats.
# GITHUB_TOKEN=ghp_...

# Written by `npm run setup` when the managed seats worker is provisioned:
# SEATS_TOKEN=...
