{
  "name": "flare-actions",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source GitHub Actions alternative you host on your Cloudflare",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/everyai-com/flare-actions.git"
  },
  "bugs": {
    "url": "https://github.com/everyai-com/flare-actions/issues"
  },
  "homepage": "https://github.com/everyai-com/flare-actions#readme",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "token:mint": "node scripts/mint-token.mjs",
    "eval:models": "esbuild scripts/model-eval.mjs --bundle --platform=node --format=esm --outfile=/tmp/model-eval.bundle.mjs --log-level=error && node /tmp/model-eval.bundle.mjs",
    "runner": "npm --workspace apps/runner start",
    "cli": "npm --workspace apps/cli start",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "types": "wrangler types --include-runtime=false apps/worker/src/worker-configuration.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "bench": "node scripts/bench.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.1",
    "@cloudflare/workers-types": "^5.20260926.1",
    "@eslint/js": "^9.39.5",
    "@modelcontextprotocol/server": "^2.0.0",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.135.0",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "yaml": "^2.9.1"
  }
}
