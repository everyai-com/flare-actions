{"$schema": "./node_modules/wrangler/config-schema.json","compatibility_date": "2026-09-28","compatibility_flags": ["nodejs_compat"],"d1_databases": [{"binding": "DB","database_name": "flare-actions","migrations_dir": "migrations"}],"main": "src/index.ts","name": "flare-actions","observability": {"enabled": true,"head_sampling_rate": 1},"queues": {"consumers": [{"dead_letter_queue": "flare-actions-dlq","max_batch_size": 10,"max_batch_timeout": 30,"queue": "flare-actions-runs"}],"producers": [{"binding": "RUN_QUEUE","queue": "flare-actions-runs"}]},"vars": {"ENVIRONMENT": "production"}}
