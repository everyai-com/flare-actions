{
  "name": "flare-actions",
  "version": "0.1.0",
  "description": "CLI for Flare Actions: run pipelines locally, verify on the server in one call, and inspect runs, logs, and flakes.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "flare": "./dist/flare.mjs",
    "flare-actions": "./dist/flare.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "ci",
    "github-actions",
    "cloudflare",
    "workers",
    "cli",
    "local-ci"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/everyai-com/flare-actions.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/everyai-com/flare-actions#readme",
  "scripts": {
    "start": "node --experimental-strip-types src/index.ts",
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "devDependencies": {
    "flare-actions-runner-sdk": "0.1.0"
  }
}
