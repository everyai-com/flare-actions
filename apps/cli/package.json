{
  "name": "flare-forge",
  "version": "0.1.0",
  "description": "CLI for Flare Forge (intent-native git for many agents on one repo) and Flare Actions (its CI engine): declare intents, connect agents over MCP, verify runs, read digests.",
  "keywords": [
    "agents",
    "mcp",
    "git",
    "ci",
    "cloudflare",
    "artifacts",
    "claude-code",
    "codex",
    "cursor",
    "forge"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "flare-forge": "./bin/flare.mjs",
    "flare": "./bin/flare.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/everyai-com/flare-actions.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/everyai-com/flare-actions#readme",
  "bugs": {
    "url": "https://github.com/everyai-com/flare-actions/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/index.ts",
    "build": "node scripts/build.mjs",
    "prepublishOnly": "node scripts/build.mjs && node dist/cli.mjs forge help >/dev/null"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "flare-actions-runner-sdk": "0.1.0"
  }
}
